# ── API Keys ──────────────────────────────────────────────────────────────────
NEWS_API_KEY=your_news_api_key_here
MASSIVE_API_KEY=your_polygon_api_key_here

# ── Database ──────────────────────────────────────────────────────────────────
# For master-cloud (Neon): use the connection string from your Neon project dashboard.
# Format: postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
ASYNC_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set on Render to your Vercel URL to lock CORS to only your frontend.
# Comma-separate multiple origins if needed.
# Leave as * for local dev (or omit this variable entirely).
ALLOWED_ORIGINS=https://your-app.vercel.app

# ── ML Model ──────────────────────────────────────────────────────────────────
FINBERT_MODEL=ProsusAI/finbert
FINBERT_BATCH_SIZE=16

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=production