# Application API Keys
NEWS_API_KEY=your_news_api_key_here
MASSIVE_API_KEY=your_polygon_api_key_here

# Database Configurations
DATABASE_URL=postgresql://user:password@host:port/dbname
ASYNC_DATABASE_URL=postgresql://user:password@host:port/dbname

# Stock Watchlist (comma-separated)
WATCHLIST=AAPL,TSLA,MSFT,GOOGL,AMZN

# Ingestion Intervals
NEWS_POLL_INTERVAL_MINUTES=15
PRICE_POLL_INTERVAL_MINUTES=5

# ML Model Settings
FINBERT_MODEL=ProsusAI/finbert
FINBERT_BATCH_SIZE=16

# FastAPI Settings
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# Environment Mode
ENVIRONMENT=development